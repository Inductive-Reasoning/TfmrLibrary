<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\FEMLib\**\*.cs" Link="FEM\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\CircuitLib\**\*.cs" Link="Circuit\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="GeomLibrary\**" />
    <EmbeddedResource Remove="GeomLibrary\**" />
    <None Remove="GeomLibrary\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="MathNet.Numerics.Data.Text" Version="5.0.0" />
    <PackageReference Include="MathNet.Numerics.Providers.MKL" Version="5.0.0" />
    <PackageReference Include="PureHDF" Version="2.2.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\GeomLibrary\GeometryLib\GeometryLib.csproj" />
    <ProjectReference Include="..\..\..\GeomLibrary\MeshLib\MeshLib.csproj" />
  </ItemGroup>

</Project>
